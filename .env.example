# Copiez ce fichier en .env et renseignez vos valeurs personnelles.
# Le fichier .env n'est pas commité (voir .gitignore).
# Utilisé par docker compose, scripts/register_model.py et l'inférence locale.

# --- DVC / Google Drive (ETL & train containers) ---
# Same client_id / client_secret as in .dvc/config.local
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
# Host path to the OAuth token from a one-time interactive `dvc pull` / `dvc push`
DVC_GDRIVE_CREDENTIALS_PATH=.dvc/tmp/gdrive-user-credentials.json
# ETL defaults to pull inside the container; train defaults to 0 (data already prepared)
DVC_PULL=1
# 1 = allow dvc pull to overwrite/remove local untracked files under data/
# (needed when a previous ETL left manifest.parquet / train_folder). ETL default: 1
DVC_PULL_FORCE=1
# Floating tag always pointing at the newest dataset version (updated by make data-ingest)
DATA_VERSION=data-latest

# --- Incoming images (INFRA-04) ---
# local = drop files under incoming/<class>/ ; gdrive = future Drive sync (needs folder id)
INCOMING_SOURCE=local
# Drive folder id de incoming_images/ — cf. https://drive.google.com/drive/folders/1dAEaH4KxmOCkS0hRKN5SsNePLeyJ17VQ
INCOMING_GDRIVE_FOLDER_ID=1dAEaH4KxmOCkS0hRKN5SsNePLeyJ17VQ

# --- Airflow (DockerOperator bind mounts) ---
# Absolute path to this repo ON THE HOST (not inside a container).
# Required so Airflow can mount ./data, ./models, ./logs into ETL/train containers.
# Examples:
#   Linux/macOS : HOST_PROJECT_DIR=/home/you/projects/sep25_alt1_mle_ds_covid1
#   Windows     : HOST_PROJECT_DIR=C:/Projects/Projet MLops/sep25_alt1_mle_ds_covid1
# If unset, docker-compose falls back to ${PWD} (often wrong when Compose runs in Docker).
HOST_PROJECT_DIR=

# --- W&B ---
# Si WANDB_API_KEY est vide, le training tourne en mode offline automatiquement.
WANDB_API_KEY=
# Votre identifiant W&B (obligatoire pour l'inférence)
WANDB_ENTITY=
# Nom du projet W&B pour l'entraînement (configs Hydra : radiologist)
WANDB_PROJECT=radiologist

# --- W&B Model Registry (inférence) ---
# Nom du registry W&B (sans le préfixe wandb-registry-)
WANDB_REGISTRY=Radiocovid-classifier
WANDB_REGISTRY_MODEL=radiocovid-classifier
# Alias du modèle à servir : production, latest, v0, prod, …
WANDB_REGISTRY_ALIAS=production
# Projet source si le download registry est bloqué (fallback inférence)
WANDB_REGISTRY_SOURCE_PROJECT=radiocovid
# Optionnel : chemin complet copié depuis l'onglet Usage du registry W&B
# WANDB_REGISTRY_ARTIFACT=wandb-registry-Radiocovid-classifier/radiocovid-classifier:production
